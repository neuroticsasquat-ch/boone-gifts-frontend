# Backend base URL. The browser talks to the API directly, so this has to be a
# URL the *browser* can reach — not a compose service name. The dev stack
# publishes api on 8000; on a remote workspace use its api subdomain instead,
# e.g. https://api--<workspace>.<host>, and add this app's origin to the
# backend's APP_CORS_ORIGINS.
VITE_API_URL=http://localhost:8000

# Error reporting goes to Bugsink via the Sentry SDK (optional). Leave the DSN
# empty to disable it locally. The source-map upload variables (SENTRY_URL,
# SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN) are build-time only, set on the
# build host, and not needed for local development — see the README.
VITE_SENTRY_DSN=
# Tag for Sentry events; the code falls back to "production" when unset.
# VITE_SENTRY_ENVIRONMENT=development
