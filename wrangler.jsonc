// An assets-only Worker (NEU-1630): no `main`, so no Worker script runs — the
// platform serves dist/ directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boone-gifts-frontend",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    // Unknown paths answer index.html with a 200, so deep links reach the router.
    "not_found_handling": "single-page-application"
  }
}
